{
  "multipart": [
    { "apply": { "model": "quarryindustrial:block/quarry_frame_core" } },
    { "when": { "north": "true" }, "apply": { "model": "quarryindustrial:block/quarry_frame_arm" } },
    { "when": { "east": "true" }, "apply": { "model": "quarryindustrial:block/quarry_frame_arm", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "quarryindustrial:block/quarry_frame_arm", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "quarryindustrial:block/quarry_frame_arm", "y": 270 } },
    { "when": { "up": "true" }, "apply": { "model": "quarryindustrial:block/quarry_frame_arm_up" } },
    { "when": { "down": "true" }, "apply": { "model": "quarryindustrial:block/quarry_frame_arm_down" } }
  ]
}
